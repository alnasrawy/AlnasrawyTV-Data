# Telegram bot token (from @BotFather)
TG_BOT_TOKEN=

# Comma-separated chat/channel IDs to publish the cards on
# (e.g. -1001234567890,@my_channel,123456789)
TG_CHANNELS=

# Private chat ID for operational alerts (repeat failures, crashes)
TG_ADMIN_CHAT_ID=

# Optional: absolute directory for generated images (default: ./out_imgs)
IMAGE_DIR=

# The timezone is fixed internally to Asia/Baghdad — nothing to set here.
# Copy this file to `.env` and fill in the real values (never commit `.env`).